# LeRobot device symlinks
# Install: sudo cp 99-lerobot-devices.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules && sudo udevadm trigger
#
# After install, fixed symlinks are available at:
#   /dev/leader_left, /dev/leader_right
#   /dev/follower_left, /dev/follower_right
#   /dev/cam_left_wrist, /dev/cam_right_wrist, /dev/cam_top

# --- Serial arms (OpenRB-150) ---
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="129A6D4B503059384C2E3120FF09113F", SYMLINK+="leader_left"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="55AE2891503059384C2E3120FF072140", SYMLINK+="leader_right"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="0DB31F42503059384C2E3120FF07192F", SYMLINK+="follower_left"
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="00D227A3503059384C2E3120FF06181D", SYMLINK+="follower_right"

# --- Cameras (video4linux, capture nodes only) ---
SUBSYSTEM=="video4linux", ENV{ID_V4L_CAPABILITIES}==":capture:", ENV{ID_SERIAL}=="170428-_Integrated_Webcam_HD",                              SYMLINK+="cam_left_wrist"
SUBSYSTEM=="video4linux", ENV{ID_V4L_CAPABILITIES}==":capture:", ENV{ID_SERIAL}=="Generic_USB2.0_PC_CAMERA",                              SYMLINK+="cam_right_wrist"
SUBSYSTEM=="video4linux", ENV{ID_V4L_CAPABILITIES}==":capture:", ENV{ID_SERIAL}=="Sonix_Technology_Co.__Ltd._USB_2.0_Camera_AY2H91100TN",    SYMLINK+="cam_top"
